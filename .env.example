# Use a dedicated, user-owned Neon demo project (PostgreSQL 17).
# Neon CLI writes DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct).
# For manual setup, copy both URLs from Neon Connect for the same branch/database/role.
# Raw postgresql:// and postgresql+psycopg:// both work; the backend uses Psycopg 3.
# Preserve encoded credentials, sslmode=require and channel_binding=require.
# No local fallback. An explicit MIGRATION_DATABASE_URL overrides the CLI's direct URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# MIGRATION_DATABASE_URL=
# Free routes still require an OpenRouter key and account route access/rate limits.
# Liquid may retain inputs/embeddings for training: use fictional/synthetic data only.
# Nemotron uses prompt-only JSON generation, followed by strict server validation.
# Server-only key; never use a VITE_ variable.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# Managed Neon Auth endpoints; public URLs, not API keys.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Only bootstraps an empty workspace. The owner must verify this email with Neon Auth.
BOOTSTRAP_ADMIN_EMAIL=
# Docker always captures app emails in Mailpit. Native launch uses its loopback SMTP port.
MAIL_DELIVERY_MODE=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=support@example.com
