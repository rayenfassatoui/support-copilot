# Use a dedicated, user-owned Neon project (PostgreSQL 17).
# Neon CLI writes DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct).
# For manual setup, copy both URLs from Neon Connect for the same branch/database/role.
# Raw postgresql:// and postgresql+psycopg:// both work; the backend uses Psycopg 3.
# Preserve encoded credentials, sslmode=require and channel_binding=require.
# No local fallback. An explicit MIGRATION_DATABASE_URL overrides the CLI's direct URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# MIGRATION_DATABASE_URL=
# Free routes still require an OpenRouter key and account route access/rate limits.
# Liquid may retain inputs/embeddings for training: use synthetic or explicitly authorized data.
# Nemotron uses a forced structured tool response with source-bound quotes and strict server validation.
# Server-only key; never use a VITE_ variable.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# Managed Neon Auth endpoints; public URLs, not API keys.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Only bootstraps an empty workspace. The owner must verify this email with Neon Auth.
BOOTSTRAP_ADMIN_EMAIL=
# Local development: GreenMail receives synthetic email; Mailpit captures outgoing replies.
# Native npm scripts map these Docker service names to 127.0.0.1.
MAIL_DELIVERY_MODE=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=support@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=mailbox
IMAP_PORT=3143
IMAP_SECURITY=none
IMAP_USERNAME=support
IMAP_PASSWORD=local-mail-only
IMAP_FOLDER=INBOX
MAILBOX_POLL_SECONDS=30
PUBLIC_APP_URL=http://localhost:8080
# External mailbox: MAIL_DELIVERY_MODE=smtp, real SMTP/IMAP hosts and credentials.
# Require SMTP_SECURITY=starttls (587) or tls (465), IMAP_SECURITY=tls (993).
# Set PUBLIC_APP_URL to the deployed HTTPS app origin for customer survey links.
